// probes/values/unknown-names.kdl -- a name the format does not define.
//
// doc/template.md#unknown-names: a node or a property the format does not
// define is accepted rather than refused, so a template written for a
// newer, an older or a different implementation still loads.  A name is
// warned about unless it says it is deliberate -- an `x-` prefix, or a
// listing in `accept` -- and only a near miss of a name legal on that node
// is an error, because `printwhn=` is a misspelling far more often than an
// extension, and taking it for one paints an element on every record that
// `printwhen` meant to suppress.
//
// The three tiers this carries are `wobble`, registered by `accept`;
// `x-vendor-hint`, reserved by its prefix; and `sprocket`, which is
// neither and is the one warning the load produces.  No near miss is
// here, since this probe is about what builds and that one does not.
//
// That warning's message is where the two engines part: this one ends it
// with the children `detail` does take, and the reference stops at the
// node.  Registered as the divergence `unknown-node-lists-what-fits`.

report name="values/unknown-names" {
  accept "wobble"
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" {
    style font="body" color="black"
    detail height=20 {
      field text="x" left=0 top=0 width=100 height=10 wobble=#true
      field text="y" left=0 top=10 width=100 height=10 x-vendor-hint="ignored"
      sprocket teeth=9
    }
  }
}
