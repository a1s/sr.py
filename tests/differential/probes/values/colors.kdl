// probes/values/colors.kdl -- what each colour spelling resolves to.
//
// template.md named the four spellings and the 22 names without giving
// the names' values, so the six that are not HTML 4.01 were the open part:
// a reader could reasonably have taken `darkgray` for Java's #404040 or
// CSS' #A9A9A9, and the two look nothing alike on a page.
//
// Every row below is one rectangle whose stroke carries the answer,
// read straight out of the mark.  The names come first, then the other
// three spellings and the edges that decide how each is read: which reading
// a mixed triple takes, what a float component rounds to, and that the high
// bits of the single integer are dropped rather than being an error.
//
// doc/template.md#color is what this became.  The spellings that are
// *refused* are not here -- a probe has to build -- and are held to
// the same section by the unit tests instead.

report name="values/colors" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body"
    detail height=210 {
      rectangle left=0 top=0 width=5 height=5 { style color="black" }
      rectangle left=0 top=6 width=5 height=5 { style color="silver" }
      rectangle left=0 top=12 width=5 height=5 { style color="gray" }
      rectangle left=0 top=18 width=5 height=5 { style color="white" }
      rectangle left=0 top=24 width=5 height=5 { style color="maroon" }
      rectangle left=0 top=30 width=5 height=5 { style color="red" }
      rectangle left=0 top=36 width=5 height=5 { style color="purple" }
      rectangle left=0 top=42 width=5 height=5 { style color="fuchsia" }
      rectangle left=0 top=48 width=5 height=5 { style color="green" }
      rectangle left=0 top=54 width=5 height=5 { style color="lime" }
      rectangle left=0 top=60 width=5 height=5 { style color="olive" }
      rectangle left=0 top=66 width=5 height=5 { style color="yellow" }
      rectangle left=0 top=72 width=5 height=5 { style color="navy" }
      rectangle left=0 top=78 width=5 height=5 { style color="blue" }
      rectangle left=0 top=84 width=5 height=5 { style color="teal" }
      rectangle left=0 top=90 width=5 height=5 { style color="aqua" }
      rectangle left=0 top=96 width=5 height=5 { style color="cyan" }         // aqua's other name
      rectangle left=0 top=102 width=5 height=5 { style color="darkgray" }
      rectangle left=0 top=108 width=5 height=5 { style color="lightgray" }
      rectangle left=0 top=114 width=5 height=5 { style color="magenta" }     // fuchsia's other name
      rectangle left=0 top=120 width=5 height=5 { style color="orange" }
      rectangle left=0 top=126 width=5 height=5 { style color="pink" }
      rectangle left=0 top=132 width=5 height=5 { style color="DarkGray" }    // names ignore case
      rectangle left=0 top=138 width=5 height=5 { style color=" red " }       // and surrounding space
      rectangle left=0 top=144 width=5 height=5 { style color="#aabbcc" }     // hex, canonicalised upward
      rectangle left=0 top=150 width=5 height=5 { style color="0,89,0" }      // three integers, 0-255
      rectangle left=0 top=156 width=5 height=5 { style color=" 1 , 2 , 3 " } // space around each
      rectangle left=0 top=162 width=5 height=5 { style color="1,1,1" }       // integers, so nearly black
      rectangle left=0 top=168 width=5 height=5 { style color="1.0,1.0,1.0" } // floats, so white
      rectangle left=0 top=174 width=5 height=5 { style color="0,1,0." }      // one dot reads all three
      rectangle left=0 top=180 width=5 height=5 { style color=".5,.5,.5" }    // -> 128, half goes up
      rectangle left=0 top=186 width=5 height=5 { style color="0.25,0.5,0.75" } // -> 64, 128, 191
      rectangle left=0 top=192 width=5 height=5 { style color="16711935" }    // one integer, by bits
      rectangle left=0 top=198 width=5 height=5 { style color="16777216" }    // bit 24 and up: dropped
      rectangle left=0 top=204 width=5 height=5 { style color="00255" }       // leading zeros, still ten
    }
  }
}
