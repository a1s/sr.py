// probes/values/pagesize-card.kdl -- what a page size name is worth.
//
// One of the four; see `pagesize-iso` for the question all four ask.
//
// ISO 7810 ID-1, which the standard states on its side as 85.60 x 53.98mm.
// Portrait, as the table holds it, that is 2.125 x 3.37in exactly:
// the inches are the round figure here and the millimetres are not.
//
// doc/template.md#enumerations is what this became.

report name="values/pagesize-card" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="BusinessCard" \
         leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail height=10 {
      rectangle left=0 top=0 width=1 height=1
    }
  }
}
