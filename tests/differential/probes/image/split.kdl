// probes/image/split.kdl -- an image in a band that splits.
//
// doc/layout.md#legal-split-points lets a cut fall between the lines of a
// stretch field and nowhere through a mark that cannot split, and an image
// is one, as a barcode is.  The band is a field of sixty lines, 12 apart,
// on pages 300 tall, so with nothing else in it the band would be cut at
// 300 and 600.  An image 24 tall spans 290 to 314, across the first, and
// the cut moves up to the last line boundary above it, 288; the image
// starts the second page 2 down.  A `grow` image 12 tall spans 570 to 582,
// across nothing, and the second cut stays where the page puts it.
//
// doc/layout.md#band-splitting is what this became.

report name="image/split" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout width=500 height=300 leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail split=#true {
      field expr="'\\n'.join(['line %d' % i for i in range(60)])" left=0 width=60 stretch=#true
      image file="wide.png" embed=#false scale="fill" left=100 top=290 width=48 height=24
      image file="wide.png" embed=#false scale="grow" left=200 top=570
    }
  }
}
