// probes/image/natural.kdl -- what an image's natural size is.
//
// Every image here sits in a box 100 by 100 with the default `scale="cut"`,
// so the mark's box is the natural size: an image smaller than its box
// is drawn at that size and nothing is clipped.  The reference reads
// the size from the header and draws one point per pixel, and nothing
// else about the file moves it:
//
// - `dpi.png` carries a `pHYs` chunk saying 144 dots per inch and
//   `wide.jpg` a JFIF density of 300; both are 24 by 12, as `wide.png`;
// - `rotated.jpg` carries an EXIF orientation of 6, which a photo viewer
//   turns a quarter turn, and is still 24 wide and 12 tall;
// - `progressive.jpg` is read as a baseline one is;
// - `screen.gif` has a logical screen of 30 by 20 holding one frame
//   of 24 by 12, and its natural size is the screen's;
// - `png.jpg` holds PNG bytes under a JPEG name, and its `type` is `png`:
//   the format is sniffed from the content, never from the name.
//
// All are `embed=#false`, so the header carries no blobs and the marks
// carry paths -- which the recorded answer replaces, keeping the base name,
// since they are relative to wherever the printout landed.
// The files are read all the same, since the size is in them.
// doc/template.md#image and doc/layout.md#an-image-in-its-box are
// what this became.

report name="image/natural" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout width=500 height=800 leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail {
      image file="wide.png" embed=#false left=0 top=0 width=100 height=100
      image file="dpi.png" embed=#false left=100 top=0 width=100 height=100
      image file="wide.jpg" embed=#false left=200 top=0 width=100 height=100
      image file="rotated.jpg" embed=#false left=300 top=0 width=100 height=100
      image file="progressive.jpg" embed=#false left=0 top=100 width=100 height=100
      image file="wide.gif" embed=#false left=100 top=100 width=100 height=100
      image file="screen.gif" embed=#false left=200 top=100 width=100 height=100
      image file="png.jpg" embed=#false left=300 top=100 width=100 height=100
    }
  }
}
