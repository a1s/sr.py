// probes/image/fill.kdl -- what `scale="fill"` draws.
//
// `fill` scales the image to its box.  With `proportional=#true`,
// the default, the image keeps its aspect ratio: the axis whose ratio
// of box to image is smaller takes the box's extent exactly, the other
// is the image's extent times that ratio, rounded to three decimals,
// and the result is placed in the box by `halign` and `valign`.
//
// - `a`, `b` and `c` put `wide.png`, 24 by 12, into boxes 40 by 40:
//   40 by 20, at the top, the middle and the bottom;
// - `d` has a box narrower than the image's proportions, so width is the
//   limiting axis and the image is 10 by 5 at the bottom of a box 40 tall;
//   `e` has one wider, so height limits it, 20 by 10 at the right;
// - `f` is `odd.png`, 7 by 5, into 10 by 10: 10 by 7.143,
//   centred down at 51.429;
// - `g` is the same image into 10 by 3.333, where height limits it:
//   7 times 3.333 over 5 is 4.6662, written 4.666, and centred across;
// - `h` is the same into 33.333 by 100: 23.809 tall, centred down;
// - `i` has a box of no width, and the image is drawn at no size at all;
// - `j` is the natural size already, and comes out unchanged.
//
// With `proportional=#false` the image is stretched to the box exactly,
// and alignment has nothing to place: `k` is 40 by 40 whatever it says.
// Scaling is the only thing `fill` does, so there is never a `crop`.
// doc/layout.md#an-image-in-its-box is what this became.

report name="image/fill" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout width=500 height=800 leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail {
      // a, b, c
      image file="wide.png" embed=#false scale="fill" left=0 top=0 width=40 height=40
      image file="wide.png" embed=#false scale="fill" left=50 top=0 width=40 height=40 halign="center" valign="center"
      image file="wide.png" embed=#false scale="fill" left=100 top=0 width=40 height=40 halign="right" valign="bottom"
      // d, e
      image file="wide.png" embed=#false scale="fill" left=150 top=0 width=10 height=40 valign="bottom"
      image file="wide.png" embed=#false scale="fill" left=200 top=0 width=100 height=10 halign="right"
      // f, g, h
      image file="odd.png" embed=#false scale="fill" left=0 top=50 width=10 height=10 valign="center"
      image file="odd.png" embed=#false scale="fill" left=50 top=50 width=10 height=3.333 halign="center"
      image file="odd.png" embed=#false scale="fill" left=100 top=50 width=33.333 height=100 valign="center"
      // i, j
      image file="odd.png" embed=#false scale="fill" left=150 top=50 width=0 height=10
      image file="odd.png" embed=#false scale="fill" left=200 top=50 width=7 height=5
      // k
      image file="wide.png" embed=#false scale="fill" proportional=#false left=300 top=0 width=40 height=40 halign="right" valign="bottom"
    }
  }
}
