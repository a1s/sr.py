// probes/expressions/strings.kdl -- what a string counts as its elements.
//
// A registered divergence: codepoints here, bytes in the reference.
// See `divergences.toml`, entry `strings-are-codepoints`.
//
// "Šķūnis" is six codepoints and nine UTF-8 bytes -- C5 A0 C4 B7 C5 AB 6E 69 73 --
// so `len` alone separates the two readings and the indices show what is at stake.
//
// Not every index does.  `[-1]` and `[-3]` land on `s` and `n` either way, because
// the tail of this word is ASCII, and an index chosen without checking can look
// like agreement where there is none.  The four below are chosen to diverge.
//
// This probe is what moved the reference's figure from inferred to measured.

report name="expressions/strings" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail height=100 {
      field expr="str(len('Šķūnis'))" left=0 top=0 width=400 height=12 stretch=#true      // reference: 9.  here: 6
      field expr="'%r' % ('Šķūnis'[0],)" left=0 top=20 width=400 height=12 stretch=#true  // reference: byte C5, half a letter.  here: the letter
      field expr="'%r' % ('Šķūnis'[:3],)" left=0 top=40 width=400 height=12 stretch=#true // reference: a whole letter and a dangling C4
      field expr="'%r' % ('Šķūnis'[-4],)" left=0 top=60 width=400 height=12 stretch=#true // a negative index cuts just the same
      field expr="'%r' % ('Šķūnis'[:2],)" left=0 top=80 width=400 height=12 stretch=#true // two bytes that happen to be one letter: no glyph is broken
    }
  }
}
