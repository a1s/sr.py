// probes/expressions/lambda-parameters.kdl -- the parameters left out.
//
// A lambda takes plain parameters and their defaults, and the four forms
// below are the rest of Starlark's parameter grammar, which it does not.
// Both engines refuse them, so there is no answer file beside this probe.
//
// Three of the four are a choice: `*args`, `**kwargs`, and the bare `*`
// that makes what follows it keyword-only.  The fourth is not.
// Python parses `__debug__` as a parameter and then refuses to bind it,
// and supporting it would mean renaming it throughout the lambda's body.
//
// `/` is not here because neither engine names it: the reference calls
// it "not an identifier", where the four below each get a message of
// their own, which is what makes them worth asking about together.

report name="expressions/lambda-parameters" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail height=80 {
      field expr="str((lambda *rest: rest)(1, 2))" left=0 top=0 width=400 height=12 stretch=#true                  // (1, 2)
      field expr="str((lambda **named: named)(one=1))" left=0 top=20 width=400 height=12 stretch=#true              // {"one": 1}
      field expr="str((lambda one, *, two: one + two)(1, two=2))" left=0 top=40 width=400 height=12 stretch=#true   // 3
      field expr="str((lambda __debug__: __debug__)(5))" left=0 top=60 width=400 height=12 stretch=#true            // 5: an identifier like any other in Starlark
    }
  }
}
