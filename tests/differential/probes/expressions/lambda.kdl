// probes/expressions/lambda.kdl -- the lambda the dialect takes.
//
// `starlark-go` retired `resolve.AllowLambda`, so the reference takes a
// lambda whether it chose to or not, and this engine refused one until
// now.  This is what says the two agree on the forms both accept.
//
// Only plain parameters and their defaults are here.  Starlark's own
// lambda also takes `*args` and `**kwargs`, and this one does not,
// which is a divergence until doc/expressions.md settles it.

report name="expressions/lambda" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail height=100 {
      field expr="str((lambda value: value + 1)(2))" left=0 top=0 width=400 height=12 stretch=#true                        // 3
      field expr="str((lambda value, plus=10: value + plus)(1))" left=0 top=20 width=400 height=12 stretch=#true           // 11: the default is read where the lambda is written
      field expr="str(sorted(['bb', 'a'], key=lambda word: len(word)))" left=0 top=40 width=400 height=12 stretch=#true    // ["a", "bb"]: what a lambda is mostly for
      field expr="str(type(lambda value: value))" left=0 top=60 width=400 height=12 stretch=#true                          // function, not builtin_function_or_method
      field expr="str(lambda value: value)" left=0 top=80 width=400 height=12 stretch=#true                                // <function lambda>, carrying no address
    }
  }
}
