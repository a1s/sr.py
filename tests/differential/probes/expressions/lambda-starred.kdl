// probes/expressions/lambda-starred.kdl -- the lambda parameters left out.
//
// A registered divergence: the reference takes `*args`, `**kwargs` and the
// bare `*` that makes what follows it keyword-only, and this engine refuses
// all three.  See `divergences.toml`, entry `lambda-starred-parameters`.
//
// `/` is not here because neither engine takes it.  The reference calls it
// "not an identifier", so it is a refusal the two share rather than a
// difference, and a probe would have nothing to record.

report name="expressions/lambda-starred" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail height=60 {
      field expr="str((lambda *rest: rest)(1, 2))" left=0 top=0 width=400 height=12 stretch=#true                  // (1, 2)
      field expr="str((lambda **named: named)(one=1))" left=0 top=20 width=400 height=12 stretch=#true              // {"one": 1}
      field expr="str((lambda one, *, two: one + two)(1, two=2))" left=0 top=40 width=400 height=12 stretch=#true   // 3
    }
  }
}
