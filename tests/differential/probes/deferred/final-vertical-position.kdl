// probes/deferred/final-vertical-position.kdl -- VERTICAL_POSITION through FINAL.
//
// It describes a band being measured: where it begins in its frame.
// When a scope ends no band is, so it has no value there, and doc/
// refuses it in FINAL at validation.  VERTICAL_SPACE is the same
// question and has a probe of its own, because a template is refused
// if any one of its expressions is, and one template naming both would
// say only that at least one of them is still refused.
//
// Answering with whatever band was measured last would make the value
// depend on lookaheads and reservations a template cannot see.  Here a
// deferral in the report's title waits for the first break of group A,
// and the row measured last is the second, 9.6 pt down, while the break
// itself is lower, 14.4 pt down, below that row.
//
// Both engines refuse it, so there is no answer file beside this probe.
// doc/expressions.md#final is what this became.

report name="deferred/final-vertical-position" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=4
  records {
    member "a" type="int"
  }
  layout width=200 height=100 leftmargin=5 rightmargin=5 topmargin=5 bottommargin=5 {
    style font="body" color="black"
    title height=4.8 {
      field expr="'T at %s' % FINAL.VERTICAL_POSITION" evaltime="A" left=0 top=0 width=190 height=4.8
    }
    group "A" expr="a" {
      detail height=4.8 {
        field expr="'r%d' % ITEM_NUMBER" left=0 top=0 width=190 height=4.8
      }
    }
  }
}
