// probes/layout/band-height.kdl -- the two maxima a band's height is.
//
// doc/layout.md#building-a-band settles a band's height in two stages,
// and a rule inside the band is what makes the difference visible: the rule
// is resolved against the first of them and the band ends up the second.
//
// In Go-Regular at size 10 a line is 12pt, which is what every row here
// is read against.
//
// - `title` declares a box of 6pt for a line 12pt tall.  The first height
//   is 6, so the rule spans 6; the text mark is 12 and overflows it, so
//   the band is 12 and the next band starts there.  A band that took the
//   marks into the first maximum would draw a 12pt rule, and one that took
//   only the declared boxes would start the next band 6pt higher.
// - `detail` has no element with a height of its own at all.
//   The first height is zero, the rule is zero, and the band is 32:
//   the field's box collapses at `top=20` and its line is drawn below it.
// - `summary` declares a `bottom` on a stretch field, which makes it
//   container-dependent although it has a content height.  It takes
//   no part in the first maximum either, so again the rule is zero
//   and the band is the mark.
//
// doc/layout.md#the-bands-height-is-settled-twice is what this became.

report name="layout/band-height" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout width=300 height=800 leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    title {
      field text="A" left=0 top=0 width=50 height=6
      line left=100 top=0 width=1
    }
    detail {
      field text="B" left=0 top=20 width=50
      line left=100 top=0 width=1
    }
    summary {
      field text="C" left=0 top=3 bottom=0 width=50 stretch=#true
      line left=100 top=0 width=1
    }
  }
}
