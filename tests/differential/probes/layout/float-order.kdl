// probes/layout/float-order.kdl -- which elements precede a floating one.
//
// doc/layout.md#floating-elements orders a floating element after every
// non-floating element wholly above it and after every floating element
// that starts earlier.  The second is not "wholly above": two floating
// elements whose declared boxes overlap are still ordered by their tops.
//
// In Go-Regular at size 10 a line is 12pt.
//
// - `title`: U (20..32) and T (30..42) both float and overlap.
//   U starts earlier, so T goes below it, and T's gap is measured
//   to the field wholly above it, 18, rather than to U, which is not.
// - `detail`: the same two with nothing else in the band.
//   With no predecessor wholly above it, T's gap is measured to
//   the band's top: it is 30, and T lands 30 below U's bottom edge.
// - `summary`: a rule whose height comes from the band is not
//   a predecessor, although its declared box is above F.
//   F's gap is the 8 to the field, not the 2 to the rule.
// - `header`: W floats and stretches with no declared height, so its
//   declared box has none either.  X's gap is measured to W's top.

report name="layout/float-order" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout width=300 height=800 leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    title {
      field text="1\n2\n3" left=0 top=0 height=12 width=40 stretch=#true
      field text="U" left=100 top=20 height=12 width=40 float=#true
      field text="T" left=0 top=30 height=12 width=40 float=#true
    }
    detail {
      field text="U" left=100 top=20 height=12 width=40 float=#true
      field text="T" left=0 top=30 height=12 width=40 float=#true
    }
    summary height=30 {
      field text="1" left=0 top=0 height=2 width=40 stretch=#true
      line left=100 right=100 top=0 bottom=22
      field text="F" left=0 top=10 height=12 width=40 float=#true
    }
    header {
      field text="1\n2\n3" left=0 top=0 height=12 width=40 stretch=#true
      field text="W" left=0 top=20 width=40 float=#true stretch=#true
      field text="X" left=0 top=40 height=12 width=40 float=#true
    }
  }
}
