// probes/rounding/negative.kdl -- the same question below zero.
//
// Rounding is symmetric about zero: -0.0005 goes to -0.001 exactly as 0.0005
// goes to 0.001.  That rules out truncation toward zero and rounding toward
// positive infinity, which agree with half away from zero on positive values
// and differ here, as well as half to even, which differs on both signs.
//
// A negative coordinate is reachable because an element may sit left of
// or above its container's origin; only a box's width and height are
// required to be non-negative.
//
// The container is an xref 10pt in from the page's edge, so that each field
// is rounded at its negative offset from the xref and then moved onto the
// page, where it lies inside the printable area: a mark outside it is an
// overflow by doc/layout.md#errors.  An offset rounded to -0.001 is written
// 9.999, and one rounded to 0 would be written 10.

report name="rounding/negative" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail height=116 {
      xref type="url" target="'https://example.com/'" left=10 top=0 width=100 height=116 {
        field text="q" left=-0.0005 top=0 width=20 height=12   // -> 9.999; toward zero would give 10
        field text="q" left=-0.0015 top=16 width=20 height=12
        field text="q" left=-0.0025 top=32 width=20 height=12  // -> 9.997; half to even would give 9.998
        field text="q" left=-0.1235 top=48 width=20 height=12  // -> 9.876; toward zero would give 9.877
        field text="q" left=-1.0005 top=64 width=20 height=12
        field text="q" left=-0.0045 top=80 width=20 height=12  // -> 9.995, not 9.996
      }
    }
  }
}
