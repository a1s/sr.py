// probes/subreport/at-a-break.kdl -- a subreport's band at a group break.
//
// A negative-seq subreport on the detail band, whose bands come before
// the band at the first record of a new group and run off the page.
//
// The reference builds the footer of that page against the new record:
// the subreport's band is something of the new record on the page, so the
// new run has begun, and the group's page number goes on from that page.
//
// doc/layout.md#pages.

report name="subreport/at-a-break" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=5
  records {
    member "g" type="string"
    member "rows" type="int"
  }
  layout width=100 height=50 leftmargin=5 rightmargin=5 topmargin=5 bottommargin=5 {
    style font="body" color="black"
    embedded "notes" {
      parameter "tag" type="string"
      detail height=6 {
        field expr="'%s %d pn %d' % (tag, ITEM_NUMBER, PAGE_NUMBER)" left=10 top=0 height=6
      }
    }
    footer height=6 {
      field expr="'footer pn %d gpn %d this %s gc %d' % (PAGE_NUMBER, grp_PAGE_NUMBER, THIS.g if THIS else None, grp_COUNT)" left=0 top=0 height=6
    }
    header height=6 {
      field expr="'header pn %d gpn %d this %s' % (PAGE_NUMBER, grp_PAGE_NUMBER, THIS.g if THIS else None)" left=0 top=0 height=6
    }
    group "grp" expr="g" {
      detail height=6 {
        field expr="'row %s pn %d gpn %d' % (g, PAGE_NUMBER, grp_PAGE_NUMBER)" left=0 top=0 height=6
        subreport embedded="notes" seq=-1 data="[{}] * rows" inline=#true {
          arg "tag" value="g"
        }
      }
    }
  }
}
