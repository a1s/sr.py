// probes/subreport/printwhen.kdl -- printwhen is answered once per placement.
//
// The host band prints only on page 1, and its negative-seq subreport
// fills that page, so the band itself lands on page 2.
//
// The reference asks once, before the subreport runs, and keeps the answer:
// the band prints on page 2 although PAGE_NUMBER is 2 there, and so does
// the subreport after it.  The second record is on page 2 when it is asked,
// so neither its band nor any of its subreports print.
//
// doc/layout.md#where-a-subreports-bands-go.

report name="subreport/printwhen" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=5
  records {
    member "name" type="string"
    member "rows" type="int"
  }
  layout width=100 height=50 leftmargin=5 rightmargin=5 topmargin=5 bottommargin=5 {
    style font="body" color="black"
    embedded "filler" {
      parameter "tag" type="string"
      detail height=6 {
        field expr="'%s %d pn %d' % (tag, ITEM_NUMBER, PAGE_NUMBER)" left=10 top=0 height=6
      }
    }
    detail height=6 printwhen="PAGE_NUMBER == 1" {
      field expr="'host %s pn %d vp %s' % (name, PAGE_NUMBER, VERTICAL_POSITION)" left=0 top=0 height=6
      subreport embedded="filler" seq=-1 data="[{}] * rows" inline=#true {
        arg "tag" value="'before ' + name"
      }
      subreport embedded="filler" seq=1 data="[{}]" inline=#true {
        arg "tag" value="'after ' + name"
      }
    }
  }
}
