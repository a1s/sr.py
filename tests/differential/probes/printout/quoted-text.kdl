// probes/printout/quoted-text.kdl -- how the two reports quote the report's name and a default.
//
// `validate` and `inspect` both name the report on a line of their own,
// and `validate` lists each parameter's default.  The reference quotes
// the name and the default as `%q` quotes a string: a quotation mark
// and a backslash are escaped, and so are a tab and a no-break space,
// which Unicode does not call printable.  The author is written as
// it is, quotation marks and all, and so is a version.
//
// See doc/cli.md#sr-validate and doc/expressions.md#quoted-strings.

report name="printout/quoted-text \"a\\b\"\t c" version="2" author="al \"s\"" {
  parameter "when" type="string" default="x\"y\tz"
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=8
  layout width=300 height=100 leftmargin=0 rightmargin=0 topmargin=0 bottommargin=0 {
    style font="body" color="black"
    detail height=10 {
      field text="a" left=0 width=100
    }
  }
}
