// probes/pagination/group-tables-empty.kdl -- the group tables over no records.
//
// A template with a group, built over no records at all: the title, header
// and summary print and no group ever opens.  The header's `groupRuns` and
// `groupKeys` list a group once it has opened, so here the header carries
// neither table, rather than a group with a count of 0.  A_COUNT is 0 and
// A_PAGE_NUMBER 1 all the same: doc/expressions.md#between-a-groups-runs
// gives a group's names those values before its first run.
//
// doc/printout.md#header-line is what this became.

report name="pagination/group-tables-empty" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=5
  records {
    member "g" type="int"
  }
  layout width=200 height=50 leftmargin=5 rightmargin=5 topmargin=5 bottommargin=5 {
    style font="body" color="black"
    header height=6 {
      field expr="'H A_C %d A_PN %d' % (A_COUNT, A_PAGE_NUMBER)" left=0 top=0 height=6
    }
    group "A" expr="g" {
      title height=6 {
        field text="GT" left=0 top=0 height=6
      }
      detail height=6 {
        field text="d" left=0 top=0 height=6
      }
    }
    summary height=6 {
      field text="S" left=0 top=0 height=6
    }
  }
}
