// probes/pagination/keeptogether.kdl -- keeping a group on one frame.
//
// The second group is its title, four printed rows and its summary:
// 30pt, with 10 left on the first page after the first group.
// It fits an empty frame and not what is left, so it ejects
// before its title.  The suppressed row takes no space and is
// not measured.
//
// doc/layout.md#group-keeptogether is what this became.

report name="pagination/keeptogether" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=4
  records {
    member "a" type="int"
    member "s" type="bool"
  }
  layout width=200 height=60 leftmargin=5 rightmargin=5 topmargin=5 bottommargin=5 {
    style font="body" color="black"
    title height=20 {
      field text="T" left=0 top=0 height=5
    }
    group "A" expr="a" keeptogether=#true {
      title height=5 {
        field expr="'AT a%d it %d' % (a, ITEM_NUMBER)" left=0 top=0 height=5
      }
      summary height=5 {
        field expr="'AS a%d it %d' % (a, ITEM_NUMBER)" left=0 top=0 height=5
      }
      detail height=5 printwhen="not s" {
        field expr="'r%d' % ITEM_NUMBER" left=0 top=0 height=5
      }
    }
  }
}
