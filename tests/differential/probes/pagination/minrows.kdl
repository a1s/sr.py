// probes/pagination/minrows.kdl -- rows that must follow a group's title.
//
// `minrows=2`: before the second group's title, it and the next two
// printed rows are measured, the suppressed fourth record skipped,
// 15pt against 5 left.  They do not fit, so the title moves to the
// next page with its rows.
//
// doc/layout.md#group-minrows-and-mintailrows is what this became.

report name="pagination/minrows" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=4
  records {
    member "a" type="int"
    member "s" type="bool"
  }
  layout width=200 height=60 leftmargin=5 rightmargin=5 topmargin=5 bottommargin=5 {
    style font="body" color="black"
    title height=25 {
      field text="T" left=0 top=0 height=5
    }
    group "A" expr="a" minrows=2 {
      title height=5 {
        field expr="'AT a%d it %d' % (a, ITEM_NUMBER)" left=0 top=0 height=5
      }
      summary height=5 {
        field expr="'AS a%d it %d' % (a, ITEM_NUMBER)" left=0 top=0 height=5
      }
      detail height=5 printwhen="not s" {
        field expr="'r%d' % ITEM_NUMBER" left=0 top=0 height=5
      }
    }
  }
}
