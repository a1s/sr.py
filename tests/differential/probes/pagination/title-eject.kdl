// probes/pagination/title-eject.kdl -- a report title's ejects, tested after it.
//
// The report's own title evaluates its `eject` nodes after it is placed,
// so `require` is measured against what the title leaves.  Here the first
// node is never selected, and the second asks for 100pt of a frame that
// has 44 left once the title is in, so the title gets a page of its own
// and the rows start the second.
//
// doc/layout.md#eject-nodes is what this became.

report name="pagination/title-eject" {
  font "body" file="../../../../example/fonts/Go-Regular.ttf" size=5
  layout width=100 height=60 leftmargin=5 rightmargin=5 topmargin=5 bottommargin=5 {
    style font="body" color="black"
    title height=6 {
      eject when="False"
      eject require=100
      field text="T" left=0 top=0 height=6
    }
    detail height=10 {
      field expr="'r%d pn %d vp %s' % (ITEM_NUMBER, PAGE_NUMBER, VERTICAL_POSITION)" left=0 top=0 height=6
    }
  }
}
