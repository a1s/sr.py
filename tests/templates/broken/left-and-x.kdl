// broken/left-and-x.kdl -- a box written with both spellings of one edge.
//
// expect: left and x are the same property
// expect: top and y are the same property

report name="probe" {
  font "body" file="../../../example/fonts/Go-Regular.ttf" size=10
  layout pagesize="A4" {
    style font="body" color="black"
    detail height=20 {
      field text="x" left=1 x=2 width=10
      field text="y" top=1 y=2 height=5
    }
  }
}
