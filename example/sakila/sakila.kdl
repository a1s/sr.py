// sakila.kdl -- the reference example template.
//
// A payment list grouped by customer, laid out in two columns. It is written for
// coverage: every band type, a group with its own title and summary, columns
// with their own header and footer, stretch fields, a floating element, six
// barcode types, an embedded image and a referenced one, both kinds of xref,
// conditional outline entries, a conditional column eject, a deferred page
// count, justified text, and typed parameters.
//
// Build it with:
//   sr build -t sakila.kdl -d payments.jsonl -o sakila.pdf

report name="DVD rental payments" \
       description="Payments by customer, from the Sakila sample database" \
       version="2" author="als" \
{

  // The reporting period. Payments outside it are suppressed by the detail
  // band's printwhen. The defaults cover the whole dataset; override either with
  //   sr build ... --param period_start=2005-06-01
  parameter "period_start" type="date" default="2005-01-01" prompt=#true
  parameter "period_end"   type="date" default="2006-01-01" prompt=#true

  // A computed default rather than a literal one.
  // BUILD_TIME is fixed for the run, so the report stays reproducible.
  parameter "as_of" type="datetime" defaultexpr="BUILD_TIME"

  records {
    member "customer_id" type="int"
    member "amount"      type="decimal"
    member "rental_date" type="datetime"
    member "return_date" type="datetime" nullable=#true
    member "customer"    type="object"
    member "film"        type="object"
  }

  variable "customer_amount" expr="amount" calc="sum" reset="group" resetgrp="customer"
  variable "column_amount"   expr="amount" calc="sum" reset="column"
  variable "page_amount"     expr="amount" calc="sum" reset="page"
  variable "total_amount"    expr="amount" calc="sum"
  variable "customers_count" expr="1" init="0" calc="sum" iter="group" itergrp="customer"

  // Committed fonts, so the example builds identically everywhere and works
  // under --strict-fonts. `bold` is not set alongside `file` -- a bold face is
  // its own file. To use whatever the machine has instead, replace `file` with
  // e.g. typeface="Arial" and add bold=#true.
  font "title"     file="../fonts/Go-Bold.ttf"    size=14
  font "pagetitle" file="../fonts/Go-Regular.ttf" size=12
  font "body"      file="../fonts/Go-Regular.ttf" size=8
  font "bold"      file="../fonts/Go-Bold.ttf"    size=8

  // A 16x16 checker, embedded. The larger image is referenced as a file
  // instead -- see the summary band -- so both paths are covered.
  data "swatch" encoding="base64" {
    content """
      iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAI0lEQVR42mNgiGSAo89v
      n8MRTvFBqIEoRUjig1HDaDwMCg0ArOyQEA2r1rMAAAAASUVORK5CYII=
      """
  }

  layout pagesize="A4" leftmargin="2.5cm" rightmargin="1.5cm" \
         topmargin="1.5cm" bottommargin="1.5cm" {

    style font="body" color="black" bgcolor="white"

    // ---------------------------------------------------------------- title

    title swapheader=#true {
      outline title="'DVD rental payments'" name="'top'" closed=#true

      // Bars need not be black. A scanner reads in red light, so what
      // decides whether a symbol scans is how much red a colour reflects:
      // navy, brown and purple bars absorb it and read, while yellow and
      // pink backgrounds reflect it and are perfectly good paper. `paper`
      // fills the whole box, quiet zone included, so the symbol carries
      // its own margin instead of borrowing whatever the band left there.
      // A pair a scanner could not read is refused when the template loads.
      barcode type="Code128" text="Code 128" valign="top" ink="navy"
      barcode type="Code39"  text="CODE 39" top=".4in" valign="top" \
              ink="#4B0082" paper="#FFE9B0"

      // FINAL.PAGE_COUNT is the row count this page ends with,
      // so the barcode is deferred to page scope. Its size depends on its content,
      // so it needs a placeholder to reserve space with. Interleaved 2 of 5
      // encodes digit pairs, so the value is padded to an even width and the
      // placeholder is the same width.
      barcode expr="FINAL.PAGE_COUNT" evaltime="page" format="%04d" text="9999" \
              type="2of5i" module="7.5mil" vertical=#true  left="1.9in"

      barcode type="Aztec" text="Aztec Code 2D :)" grow=#true \
              left="2.3in" width=".3in" halign="center" valign="top"
      barcode type="QR-L" text="Ver1" \
              left="2.3in" top=".4in" width=".3in" halign="center"
      barcode type="QR-Q" text="Version 2 (25x25)" grow=#true \
              left="2.6in" width=".9in" halign="center" valign="center"

      xref type="url" target="'https://dev.mysql.com/doc/sakila/en/'" \
           caption="'Sakila sample database documentation'" \
           left="4.5in" height="1cm" halign="right" valign="top" \
      {
        field align="right" text="DVD rental payments" {
          style font="title"
        }
      }

      // DATA_COUNT is a total already -- the dataset is buffered before
      // layout starts. total_amount is not, so it is read through FINAL.
      field align="justified" stretch=#true \
            evaltime="report" expr="(DATA_COUNT, FINAL.total_amount)" \
            format="There are %d payments on this report with total amount of %.2f" \
            text="There are 999 payments on this report with total amount of 99999.99" \
            left="3.5in" width="1in"

      // Floats below whatever the barcodes above turned out to be. The
      // declared `top` supplies the gap to the nearest element above, not an
      // absolute position. The height has to come from the field itself --
      // either declared, as here, or from `stretch` -- and not from the band's
      // bottom edge, which is not settled until after the floats are placed.
      field float=#true left=0 top="1.1in" height=12 width="3.4in" \
            expr="format('Period: %s to %s', strftime(period_start, '%d.%m.%Y'), strftime(period_end, '%d.%m.%Y'))"
    }

    // -------------------------------------------------------------- summary

    // The band is the picture's height.
    summary height="4.265cm" {
      style bgcolor="#F3EDE7"
      rectangle width=1 dash="dashdot"

      xref type="outline" target="'top'" {
        // 211x180 into 5cm x 4.265cm, the same aspect ratio, so proportional
        // scaling leaves no letterboxing. The swatch is square either way,
        // so proportional=#false costs it nothing.
        image file="thelarch.jpg" scale="fill" width="5cm" height="4.265cm"
        image data="swatch" scale="fill" proportional=#false \
              left="5.2cm" width="0.6cm" height="0.6cm"

        field align="center" left="6cm" width="11cm" height="1cm" \
              text="And now for something completely different..." \
        {
          style font="title"
        }
        field stretch=#true left="6cm" top="2cm" width="11cm" height="2cm" \
              valign="center" \
              text="Are there any other trees that any of you think you could recognize from quite a long way away?"
      }
    }

    // ------------------------------------------------- page header / footer

    header height="2cm" {
      rectangle width=1 radius="5mm" bottom="1mm"
      field halign="center" valign="center" text="Sakila payment list" {
        style font="pagetitle"
      }
    }

    footer height="1cm" {
      style font="pagetitle"
      rectangle width=1 bottom="1mm"

      field expr="PAGE_COUNT" align="left" format="Count: %i" \
            left="3mm" width="3cm"

      // Total number of pages is PAGE_NUMBER at the end of the report,
      // which is what FINAL says. The bare PAGE_NUMBER beside it still
      // reads where the field sits, so one expression gives both.
      // The box is fully determined, so no placeholder is needed.
      field expr="'Page %d of %d' % (PAGE_NUMBER, FINAL.PAGE_NUMBER)" \
            evaltime="report" align="center" \
            left="5.5cm" width="6cm"

      // A page footer is measured when the page begins, which on the first
      // page is before any record has been consumed. `sum` of nothing is None
      // rather than 0, so the guard is what makes the footer printable there.
      // `right` puts the amount where the payment column's amounts are.
      field expr="page_amount or 0" align="right" format="Total: %.2f" \
            left="12cm" right="2mm"

      field expr="strftime(as_of, '%Y-%m-%d %H:%M')" align="right" \
            valign="bottom" left="12cm" right="2mm" bottom="1mm" {
        style font="body"
      }
    }

    // -------------------------------------------------------------- columns

    columns count=2 gap="1cm" {
      header height=20 {
        style font="bold" color="#F3EDE7" bgcolor="#000900"
        rectangle width=0 top=2 bottom=2

        // 3mm in from the fill's edge, which is where the page footer's own
        // count sits, so the two line up down the page.
        field top=4 bottom=4 left="3mm" width="32mm" valign="center" \
              text="Film title"
        field top=4 bottom=4 left="35mm" width="15mm" valign="center" \
              align="center" text="Rental"
        field top=4 bottom=4 left="50mm" width="15mm" valign="center" \
              align="center" text="Return"
        field top=4 bottom=4 left="65mm" right="2mm" valign="center" \
              align="center" text="Payment"
      }

      footer height=20 {
        style font="bold" color="#F3EDE7" bgcolor="#000900"
        rectangle width=0 top=2 bottom=2

        field expr="COLUMN_COUNT" format="Count: %i" \
              top=4 bottom=4 left="3mm" width="32mm" valign="center"
        field expr="column_amount or 0" format="Total: %.2f" align="right" \
              top=4 bottom=4 left="45mm" right="2mm" valign="center"
      }
    }

    // ---------------------------------------------------------------- group

    group "customer" expr="customer_id" keeptogether=#false minrows=2 {

      title height=14 {
        style font="bold" color="#000900"

        // Don't open a customer in the last centimetre of a column.
        // `when` selects the node and `require` then decides whether it ejects,
        // so this skips the first customer, which already starts a column.
        // `customers_count` iterates at the group break, before the title.
        eject type="column" when="customers_count > 1" require="1cm"

        // Alternating prefix, to exercise first-match `when` on outlines.
        outline level=2 when="customers_count % 2" \
                title=#"format('\\ %s, %s', customer.last_name, customer.first_name)"#
        outline level=2 when="not (customers_count % 2)" \
                title=#"format('/ %s, %s', customer.last_name, customer.first_name)"#

        // maxwidth clamps the resolved extent without counting towards the
        // two-of-three, so left and width still both apply.
        field expr="(customer.last_name, customer.first_name)" format="%s, %s" \
              stretch=#true left="5mm" width="55mm" maxwidth="50mm"

        // The group's own row count, which the title cannot know yet: deferred
        // to the group scope, and stretchable, so it carries a placeholder.
        field expr="FINAL.customer_COUNT" format="Count: %i" align="right" \
              evaltime="customer" stretch=#true text="Count: 999" \
              left="60mm" right="2mm"

        line width=2 bottom=2 height=0
      }

      summary height=16 {
        style font="bold" color="#000900"
        line width=2 height=0
        field expr="(customer.last_name, customer.first_name, customer_amount)" \
              format="Total for %s, %s: %.2f" align="right" stretch=#true \
              top=4 right="2mm"
      }

      detail height=12 \
             printwhen="period_start.unix <= rental_date.unix and rental_date.unix < period_end.unix" \
      {

        style when="PAGE_COUNT % 2" bgcolor="#F3EDE7"

        // Alternating row shading: the style supplies the colour, and the
        // rectangle's own printwhen decides whether it is drawn. stroke=#false
        // keeps it fill-only -- the layout style's color="black" would
        // otherwise put a hairline border round every shaded row.
        rectangle stroke=#false printwhen="PAGE_COUNT % 2"

        field expr="film.title" stretch=#true height=10 width="35mm"

        field expr="strftime(rental_date, '%d.%m.%Y')" align="center" \
              left="35mm" height=10 width="15mm"

        // `return_date` is nullable; a null suppresses the field.
        field expr="strftime(return_date, '%d.%m.%Y')" align="center" \
              printwhen="return_date" \
              left="50mm" height=10 width="15mm"

        field expr="amount" format="%.2f" align="right" \
              left="65mm" height=10 right="2mm"

        line width=0 dash="dot" bottom=1 height=0
      }
    }
  }
}
